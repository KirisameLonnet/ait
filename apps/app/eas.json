{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "ait": {
      "extends": "production",
      "distribution": "store",
      "node": "22.23.3",
      "env": {
        "EXPO_OWNER": "sd542927172",
        "EXPO_SLUG": "ait-dev",
        "EAS_PROJECT_ID": "ee25dc95-d132-4136-9abb-dcf783c33320",
        "IOS_BUNDLE_IDENTIFIER": "com.necokeine.ait",
        "APPLE_TEAM_ID": "SVS7GV79T9"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      },
      "android": {
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "production": {
      "env": {
        "APP_VARIANT": "production"
      },
      "android": {
        "resourceClass": "large"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "resourceClass": "large",
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -x lint -x lintVitalAnalyzeRelease -x lintVitalRelease -x generateReleaseLintModel -x generateReleaseLintVitalModel"
      }
    },
    "simulator": {
      "extends": "production",
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "production",
      "distribution": "internal"
    }
  },
  "submit": {
    "ait": {
      "ios": {
        "ascAppId": "6817043477",
        "appleTeamId": "SVS7GV79T9",
        "bundleIdentifier": "com.necokeine.ait"
      }
    },
    "production": {
      "ios": {},
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
